# Hand-settled configure answers for OpenVMS (VSI C, both IA64 and x86-64).
#
# Loaded after the VSI C configure answers, so values here win.  Use this for checks the
# VSI C configure run cannot answer: run-time behaviour tests (AC_RUN_IFELSE),
# compiler-feature tests, and anything it got wrong.  Give a reason
# for every entry.

# x86 CRTL has pthread_sigmask, IA64 does not.  wget is built without threads,
# so use sigprocmask on both for identical behaviour.
ac_cv_func_pthread_sigmask=no

# configure reads byte order out of an object file in cross mode, which
# vmscc does not return.  IA64 (as used by VMS) and x86-64 are little-endian.
ac_cv_c_bigendian=no

# The CRTL's <string.h> provides mempcpy as a function-like macro (no linkable
# symbol), so configure's link test says "no"; gnulib's replacement
# declaration then collides with the macro.  Use the CRTL macro.
ac_cv_func_mempcpy=yes
gl_cv_onwards_func_mempcpy=yes


# struct sched_param is in <pthread.h> on VMS (gnulib knows; patch 0004 makes
# configure ask for host "openvms").  The VSI C configure run predates that
# patch and never asked, so record the answer here.
ac_cv_type_struct_sched_param=yes

# gnulib's strcasecmp test is a run test with no cross-compiling answer.  It
# only tests anything in a fr_FR ISO-8859-1 locale (otherwise it keeps its
# guess, "yes" for all but Solaris and Cygwin); VSI's C RTL compares bytes
# with tolower() like any C library.
gl_cv_func_strcasecmp_works=yes

# iconv(): the VSI C RTL has it on both nodes, but conversions need tables in
# SYS$I18N_ICONV (the VMSI18N kit).  Probed 2026-10-09: x86 converts
# ISO8859-1 <-> UTF-8; IA64 has no usable tables; neither has ASCII -> UTF-8
# (the default codeset).  tar copes: when iconv_open or a conversion fails,
# pax names are written and read unchanged (src/xheader.c code_string and
# decode_string).  configure cannot link-test this in the cross run, so the
# answer would otherwise be inherited from Linux.
am_cv_func_iconv=yes
am_cv_func_iconv_works=yes

# getcwd(): the CRTL's works (getcwd (NULL, 0) allocates; with
# DECC$FILENAME_UNIX_REPORT, set by vms_crtl_init.c, it returns a Unix name
# such as /USER$ROOT/IAIN/X).  The PATH_MAX test is a run test, so the cross
# run guessed "no", and gnulib's getcwd then never called it; its fallback
# walks ".." with opendir and fails with ENOENT on VMS.  That broke the
# open() of a directory, which registers the directory's name (fchdir.c), so
# tar could not archive a directory.  "partly working" makes gnulib try the
# system getcwd first.  Probed 2026-10-09.
gl_cv_func_getcwd_null=yes
gl_cv_func_getcwd_path_max='no, but it is partly working'
